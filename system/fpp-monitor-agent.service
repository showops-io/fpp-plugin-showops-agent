[Unit]
Description=ShowOps FPP Monitor Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fpp
Group=fpp
# Installed by fpp_install.sh with concrete paths substituted.
ExecStart=__PLUGIN_DIR__/system/fpp-monitor-agent.sh
Restart=always
RestartSec=5
Environment=FPP_MONITOR_AGENT_CONFIG=__CONFIG_PATH__
Environment=FPP_MONITOR_AGENT_BIN=__BIN_PATH__
Environment=FPP_MONITOR_AGENT_LOG=__LOG_FILE__

[Install]
WantedBy=multi-user.target
