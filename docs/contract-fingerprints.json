{
  "contractVersion": "1.5.2",
  "description": "Machine-readable checks for docs/PLUGIN_API_CONTRACT.md. CI fails if plugin paths or UI POST actions drift without updating the contract.",
  "frozenPaths": {
    "userConfigFile": "/home/fpp/media/plugindata/fpp-plugin-showops-agent/fpp-monitor-agent.json",
    "legacyUserConfigFile": "/home/fpp/media/config/fpp-monitor-agent.json",
    "pluginInstallDir": "/home/fpp/media/plugins/fpp-plugin-showops-agent",
    "legacyPluginInstallDir": "/home/fpp/media/plugins/showops-agent",
    "systemdUnitFileName": "fpp-monitor-agent.service",
    "pluginAgentBinary": "/home/fpp/media/plugins/fpp-plugin-showops-agent/bin/fpp-monitor-agent",
    "legacyOptAgentBinary": "/opt/fpp-monitor-agent/fpp-monitor-agent",
    "pluginLogFile": "/home/fpp/media/logs/plugin-fpp-plugin-showops-agent.log"
  },
  "pluginUiPostActions": [
    "pair",
    "unpair",
    "restart",
    "tail",
    "install"
  ],
  "fileAssertions": [
    {
      "file": "showops.php",
      "mustContain": [
        "plugindata/",
        "fpp-monitor-agent.json",
        "__DIR__",
        "fpp-monitor-agent.service",
        "action === 'pair'",
        "action === 'unpair'",
        "action === 'restart'",
        "action === 'tail'",
        "action === 'install'"
      ]
    },
    {
      "file": "scripts/fpp_install.sh",
      "mustContain": [
        "PLUGIN_DIR=\"$REPO_ROOT\"",
        "plugindata/",
        "fpp-monitor-agent.json",
        "fpp-monitor-agent.service",
        "log_install_session_start",
        "\"restart_fpp_command\": \"\""
      ]
    },
    {
      "file": "scripts/fpp_update_check.sh",
      "mustContain": [
        "bin/VERSION",
        "fpp-agent-monitor"
      ]
    },
    {
      "file": "scripts/install_common.sh",
      "mustContain": [
        "FPP_MONITOR_INSTALL_RUN_ID",
        "install_run_id=",
        "plugin-${PLUGIN_REPO_NAME}.log"
      ]
    },
    {
      "file": "scripts/fpp_uninstall.sh",
      "mustContain": [
        "log_install_session_start",
        "PLUGINDATA_DIR",
        "/var/lib/fpp-monitor-agent",
        "Uninstall complete"
      ]
    },
    {
      "file": "system/fpp-monitor-agent.sh",
      "mustContain": [
        "plugindata/${PLUGIN_REPO_NAME}/fpp-monitor-agent.json",
        "${PLUGIN_DIR}/bin/fpp-monitor-agent",
        "plugin-${PLUGIN_REPO_NAME}.log"
      ]
    },
    {
      "file": "system/fpp-monitor-agent.service",
      "mustContain": [
        "fpp-monitor-agent",
        "__PLUGIN_DIR__/system/fpp-monitor-agent.sh",
        "__CONFIG_PATH__",
        "__LOG_FILE__"
      ]
    },
    {
      "file": "menu.inc",
      "mustContain": [
        "showops.php",
        "'type' => 'content'"
      ]
    },
    {
      "file": "pluginInfo.json",
      "mustContain": [
        "\"repoName\": \"fpp-plugin-showops-agent\"",
        "fpp-plugin-showops-agent.git"
      ]
    }
  ]
}
