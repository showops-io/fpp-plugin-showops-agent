{
  "contractVersion": "1.4.0",
  "description": "Machine-readable checks for docs/PLUGIN_API_CONTRACT.md. CI fails if plugin paths or UI POST actions drift without updating the contract.",
  "frozenPaths": {
    "userConfigFile": "/home/fpp/media/config/fpp-monitor-agent.json",
    "pluginInstallDir": "/home/fpp/media/plugins/fpp-plugin-showops-agent",
    "legacyPluginInstallDir": "/home/fpp/media/plugins/showops-agent",
    "systemdUnitFileName": "fpp-monitor-agent.service",
    "optAgentBinary": "/opt/fpp-monitor-agent/fpp-monitor-agent",
    "pluginLogFile": "/home/fpp/media/logs/plugin-fpp-plugin-showops-agent.log"
  },
  "pluginUiPostActions": ["pair", "unpair", "restart", "tail"],
  "fileAssertions": [
    {
      "file": "www/showops.php",
      "mustContain": [
        "fpp-monitor-agent.json",
        "dirname(__DIR__)",
        "fpp-monitor-agent.service",
        "action === 'pair'",
        "action === 'unpair'",
        "action === 'restart'",
        "action === 'tail'"
      ]
    },
    {
      "file": "scripts/fpp_install.sh",
      "mustContain": [
        "PLUGIN_DIR=\"$REPO_ROOT\"",
        "fpp-monitor-agent.json",
        "fpp-monitor-agent.service",
        "log_install_session_start"
      ]
    },
    {
      "file": "scripts/fpp_update_check.sh",
      "mustContain": [
        "/opt/fpp-monitor-agent/VERSION",
        "fpp-agent-monitor"
      ]
    },
    {
      "file": "scripts/install_common.sh",
      "mustContain": [
        "FPP_MONITOR_INSTALL_RUN_ID",
        "install_run_id=",
        "plugin-${PLUGIN_REPO_NAME}.log"
      ]
    },
    {
      "file": "scripts/fpp_uninstall.sh",
      "mustContain": [
        "log_install_session_start",
        "rm -f \"$CONFIG_PATH\"",
        "/var/lib/fpp-monitor-agent",
        "Uninstall complete"
      ]
    },
    {
      "file": "system/fpp-monitor-agent.sh",
      "mustContain": [
        "/home/fpp/media/config/fpp-monitor-agent.json",
        "/opt/fpp-monitor-agent/fpp-monitor-agent"
      ]
    },
    {
      "file": "system/fpp-monitor-agent.service",
      "mustContain": [
        "fpp-monitor-agent",
        "/home/fpp/media/config/fpp-monitor-agent.json"
      ]
    },
    {
      "file": "menu.inc",
      "mustContain": ["showops.php", "'type' => 'content'"]
    },
    {
      "file": "pluginInfo.json",
      "mustContain": [
        "\"repoName\": \"fpp-plugin-showops-agent\"",
        "fpp-plugin-showops-agent.git"
      ]
    }
  ]
}
